# Telegram bot token from @BotFather (required)
TG_BOT_TOKEN=123456789:replace-me

# Where per-user state (saved locations, units) is persisted. Default: ./data
# DATA_DIR=./data

# Numeric Telegram user ids (comma-separated) allowed to use /stats, the usage report.
# Find yours with @userinfobot. Empty = nobody. Usage data lives in DATA_DIR/telemetry.sqlite3.
# ADMIN_USER_IDS=123456789

# Timeout in seconds for Open-Meteo / Nominatim requests. Default: 15
# HTTP_TIMEOUT=15

# Identifies the bot to Nominatim (their usage policy requires it). Change it to your own
# contact/repo if you fork the project.
# USER_AGENT=telegram-weather-bot/1.0 (+https://github.com/w0rxbend/telegram-weather-bot)

# Public identity, synced with Telegram on every start (optional overrides)
# BOT_NAME=Weather Card Bot
# BOT_SHORT_DESCRIPTION=Styled weather infographics for your location. Share it once, then /weather any time.
# BOT_DESCRIPTION=Share your location once and I'll turn it into a beautiful weather card.
